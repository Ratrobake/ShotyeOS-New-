
import os
import sys
import time
import json
import random
import platform
from datetime import datetime

VERSION = "1.10"
ROOT = os.path.join(os.path.expanduser("~"), "ShotyeOS_1.10")
FILES = os.path.join(ROOT, "Files")
CONFIG = os.path.join(ROOT, "config.json")

os.makedirs(FILES, exist_ok=True)

config = {"user": "user", "color": "cyan"}

if os.path.exists(CONFIG):
    try:
        with open(CONFIG, "r") as f:
            config.update(json.load(f))
    except:
        pass

cwd = FILES

COLORS = {
    "cyan": "\033[96m",
    "green": "\033[92m",
    "red": "\033[91m",
    "yellow": "\033[93m",
    "white": "\033[97m"
}

RESET = "\033[0m"

def color():
    return COLORS.get(config["color"], COLORS["cyan"])

def clear():
    os.system("clear")

def save():
    with open(CONFIG, "w") as f:
        json.dump(config, f)

def banner():
    print(color() + r"""
   _____ _           _       
  / ____| |         | |      
 | (___ | |__   ___ | |_ _   _  ___
  \___ \| '_ \ / _ \| __| | | |/ _ \
  ____) | | | | (_) | |_| |_| |  __/
 |_____/|_| |_|\___/ \__|\__,_|\___|

         SHOTYEOS 1.10
""" + RESET)

def neofetch():
    print(color() + """
   SHOTYEOS 1.10
   --------------------
   OS: ShotyeOS
   Kernel: Shotye Kernel 1.10
   Architecture: Python
   Terminal: Shotye Terminal
   Status: Running
""" + RESET)
    print(" User:", config["user"])
    print(" Python:", platform.python_version())
    print(" Device:", platform.system())

def help_menu():
    print("""
COMANDOS GENERALES
 help       Ayuda
 clear      Limpiar pantalla
 about      Información
 neofetch   Información visual
 date       Fecha
 time       Hora
 reboot     Reiniciar
 shutdown   Apagar

ARCHIVOS
 ls         Listar archivos
 cd         Cambiar carpeta
 pwd        Carpeta actual
 mkdir      Crear carpeta
 touch      Crear archivo
 cat        Leer archivo
 write      Escribir archivo
 rm         Eliminar archivo

HERRAMIENTAS
 calc       Calculadora
 random     Número aleatorio
 echo       Mostrar texto

SISTEMA
 whoami     Usuario actual
 setuser    Cambiar usuario
 color      Cambiar color
""")

def safe_path(name):
    path = os.path.abspath(os.path.join(cwd, name))
    if os.path.commonpath([ROOT, path]) != ROOT:
        raise ValueError("Acceso fuera del sistema")
    return path

def shell():
    global cwd

    while True:
        try:
            prompt = color() + "ShotyeOS@" + config["user"] + RESET
            folder = os.path.basename(cwd)
            cmd = input(prompt + ":" + folder + "$ ").strip()

            if not cmd:
                continue

            parts = cmd.split(maxsplit=1)
            action = parts[0].lower()
            arg = parts[1] if len(parts) > 1 else ""

            if action == "help":
                help_menu()

            elif action == "clear":
                clear()
                banner()

            elif action == "about":
                print("ShotyeOS version", VERSION)
                print("Developed in Python")
                print("Shotye Kernel 1.10")

            elif action == "neofetch":
                neofetch()

            elif action == "date":
                print(datetime.now().strftime("%d/%m/%Y"))

            elif action == "time":
                print(datetime.now().strftime("%H:%M:%S"))

            elif action == "whoami":
                print(config["user"])

            elif action == "setuser":
                if arg:
                    config["user"] = arg[:25]
                    save()
                    print("Usuario actualizado.")
                else:
                    print("Uso: setuser nombre")

            elif action == "color":
                if arg in COLORS:
                    config["color"] = arg
                    save()
                    print("Color actualizado.")
                else:
                    print("Colores:", ", ".join(COLORS))

            elif action == "pwd":
                print(cwd)

            elif action == "ls":
                for item in os.listdir(cwd):
                    suffix = "/" if os.path.isdir(os.path.join(cwd, item)) else ""
                    print(item + suffix)

            elif action == "cd":
                target = FILES if arg == ".." and cwd == FILES else safe_path(arg or FILES)
                if os.path.isdir(target):
                    cwd = target
                else:
                    print("Carpeta inexistente.")

            elif action == "mkdir":
                if arg:
                    os.makedirs(safe_path(arg), exist_ok=True)
                    print("Carpeta creada.")
                else:
                    print("Uso: mkdir nombre")

            elif action == "touch":
                if arg:
                    open(safe_path(arg), "a").close()
                    print("Archivo creado.")
                else:
                    print("Uso: touch archivo.txt")

            elif action == "cat":
                if arg:
                    with open(safe_path(arg), "r", encoding="utf-8") as f:
                        print(f.read())
                else:
                    print("Uso: cat archivo.txt")

            elif action == "write":
                if arg:
                    path = safe_path(arg)
                    print("Escribe el contenido. Usa /save para terminar.")
                    lines = []
                    while True:
                        line = input("> ")
                        if line == "/save":
                            break
                        lines.append(line)
                    with open(path, "w", encoding="utf-8") as f:
                        f.write("\n".join(lines))
                    print("Guardado.")
                else:
                    print("Uso: write archivo.txt")

            elif action == "rm":
                if arg:
                    path = safe_path(arg)
                    if os.path.isfile(path):
                        os.remove(path)
                        print("Archivo eliminado.")
                    else:
                        print("No es un archivo válido.")
                else:
                    print("Uso: rm archivo.txt")

            elif action == "echo":
                print(arg)

            elif action == "random":
                print(random.randint(1, 100))

            elif action == "calc":
                try:
                    a = float(input("Número 1: "))
                    op = input("Operación (+ - * /): ")
                    b = float(input("Número 2: "))
                    if op == "+":
                        print(a+b)
                    elif op == "-":
                        print(a-b)
                    elif op == "*":
                        print(a*b)
                    elif op == "/" and b != 0:
                        print(a/b)
                    else:
                        print("Operación inválida.")
                except ValueError:
                    print("Número inválido.")

            elif action == "reboot":
                print("Reiniciando ShotyeOS...")
                time.sleep(1)
                return "reboot"

            elif action == "shutdown":
                print("ShotyeOS apagado.")
                return "shutdown"

            else:
                print("Comando desconocido:", action)
                print("Escribe help para ver los comandos.")

        except (OSError, ValueError) as e:
            print("Error:", e)
        except KeyboardInterrupt:
            print("\nUsa shutdown para apagar ShotyeOS.")

while True:
    clear()
    banner()
    print("Iniciando ShotyeOS 1.10...")
    time.sleep(0.8)

    result = shell()

    if result == "shutdown":
        break
